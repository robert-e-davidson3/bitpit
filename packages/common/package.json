{
  "name": "@bitpit/common",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./fe.js": {
      "import": "./dist/fe.js",
      "types": "./dist/fe.d.ts"
    },
    "./be.js": {
      "import": "./dist/be.js",
      "types": "./dist/be.d.ts"
    },
    "./src/*": {
      "import": "./dist/src/*",
      "types": "./dist/src/*"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "tsx ../../node_modules/.bin/mocha 'test/**/*.test.ts' --timeout 10000",
    "typecheck": "tsc --noEmit",
    "clean": "run-p clean:*",
    "clean:dist":"rm -rf dist || true",
    "clean:buildinfo":"rm *.tsbuildinfo || true",
    "migrate": "tsx src/scripts/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Common code for BitPit",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.3.1",
    "kysely": "^0.27.0",
    "pino": "^8.19.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/chai": "^4.3.0",
    "@types/chai-as-promised": "^7.1.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.3.0",
    "chai-as-promised": "^7.1.0",
    "mocha": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3"
  }
}
