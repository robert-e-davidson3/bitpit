{
  "name": "@bitpit/backend",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--trace-warnings --trace-uncaught' tsx --watch src/index.ts",
    "build": "tsc",
    "test": "tsx ../../node_modules/.bin/mocha 'test/**/*.test.ts' --timeout 10000",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "run-p clean:*",
    "clean:dist":"rm -rf dist || true",
    "clean:buildinfo":"rm *.tsbuildinfo || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend API server for Bitpit ECS framework",
  "dependencies": {
    "@bitpit/common": "file:../common",
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.0",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^12.0.1",
    "pino": "^8.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/mocha": "^10.0.0",
    "@types/supertest": "^6.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "supertest": "^6.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3"
  }
}
